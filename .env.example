# ============================================
# Freitas Outlet - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env.local e preencha os valores

# Ambiente (development | production | test)
NODE_ENV=development

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Stripe (pagamentos com cartão) -----
# Chaves do Stripe (obter em https://dashboard.stripe.com/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ----- Banco de Dados -----
# Neon PostgreSQL (produção) ou deixe vazio para SQLite local
DATABASE_URL=

# ----- Pix -----
# CPF (apenas números) e nome do recebedor Pix
STORE_PIX_KEY=
STORE_NAME=

# ----- Email (SMTP) -----
# Configuração do servidor SMTP para envio de emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@freitasoutlet.com.br
CONTACT_EMAIL=

# ----- Segurança -----
# Chave secreta para sessão (gerar com: openssl rand -hex 32)
SESSION_SECRET=
# Duração da sessão do cliente em horas (padrão: 24). Ao expirar, o usuário precisa logar novamente.
SESSION_DURATION_HOURS=24
# Senha para acesso ao painel admin
ADMIN_PASSWORD=
# (Opcional) Chave secreta JWT
JWT_SECRET=
# Defina como true APENAS se a aplicação estiver atrás de um proxy confiável (ex.: Vercel, Nginx,
# Cloudflare, Load Balancer). Quando true, o cabeçalho x-forwarded-for é confiado para rate limiting.
# Em produção SEM proxy confiável, deixe vazio/false para que o cabeçalho enviado pelo cliente seja ignorado.
TRUST_PROXY=false

# ----- Monitoramento -----
# Sentry DSN (obter em https://sentry.io)
SENTRY_DSN=
# (Opcional) Usados na integração de build do Sentry (org/project). O upload de sourcemaps
# está desabilitado, então SENTRY_AUTH_TOKEN só é necessário se você reativar o upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ----- Analytics -----
# Google Analytics Measurement ID (opcional)
NEXT_PUBLIC_GA_ID=

# ----- Logging -----
# Nível de log: debug | info | warn | error
LOG_LEVEL=info
